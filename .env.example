# PLD-FT Backend Configuration Template
# Copy this file to .env and update with your actual values
# DO NOT commit .env to git (add to .gitignore)

# ============================================================================
# APPLICATION
# ============================================================================
DEBUG=False
PROJECT_NAME="PLD-FT Backend"

# ============================================================================
# DATABASE
# ============================================================================
# PostgreSQL Configuration (Required)
POSTGRES_SERVER=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pld_backend
# Full connection string (overrides individual settings if provided)
# SQLALCHEMY_DATABASE_URI=postgresql+asyncpg://user:password@host/dbname

# ============================================================================
# SECURITY (⚠️ MUST CHANGE IN PRODUCTION)
# ============================================================================
# Secret key for JWT token signing (generate: openssl rand -hex 32)
SECRET_KEY=your-secret-key-here-change-in-production

# Master password for superuser creation (set environment variable, not in file)
MASTER_PASSWORD=admin_master_secret

# Initial superuser credentials (change immediately after deployment)
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=admin

# JWT Configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================================================
# REDIS (for Celery task queue)
# ============================================================================
REDIS_URL=redis://redis:6379/0

# ============================================================================
# OPENAI (for RAG & Intelligence module)
# ============================================================================
# Get API key from https://platform.openai.com/account/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# ============================================================================
# EXTERNAL DATA SOURCES
# ============================================================================
# UN Consolidated Sanctions List XML
UN_SANCTIONS_XML_URL=https://scsanctions.un.org/resources/xml/sp/consolidated.xml

# SAT 69-B List (Mexico)
SAT_69B_CSV_URL=http://omawww.sat.gob.mx/cifras_sat/Documents/Listado_Completo_69-B.csv

# MEX Sanctions (Mexico - Sancionados)
MEX_SANCTIONS_CSV_URL=https://repodatos.atdt.gob.mx/api_update/sabg/servidores_publicos_sancionados_vigentes/sancionados_102025_sabg.csv

# OFAC Sanctions Lists
OFAC_SDN_XML_URL=http://www.treasury.gov/ofac/downloads/sanctions/1.0/sdn_advanced.xml
OFAC_CONS_XML_URL=https://www.treasury.gov/ofac/downloads/sanctions/1.0/cons_advanced.xml
# ============================================================================
# CORS (Cross-Origin Resource Sharing)
# ============================================================================
# Comma-separated list or JSON array of allowed origins
# Development: http://localhost:3000,http://localhost:5173
# Production: https://frontend.example.com
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================================================
# LOGGING
# ============================================================================
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================================================
# ENVIRONMENT (development, staging, production)
# ============================================================================
ENVIRONMENT=development

# ============================================================================
# FEATURE FLAGS
# ============================================================================
# Enable/disable RAG intelligence features
ENABLE_RAG=True

# Enable/disable background task processing
ENABLE_CELERY_WORKER=True

# Auto-apply migrations on startup
AUTO_MIGRATE=False
